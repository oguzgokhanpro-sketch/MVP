# PostgreSQL connection string. In Docker Compose the app service overrides the host with "postgres".
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mvp?schema=public
# Secret signing session cookies (>= 32 chars): openssl rand -base64 32
# Empty is OK for local `docker compose up` only (a public dev-only secret is used). REQUIRED for any real deployment.
AUTH_SECRET=
# Public URL of the app
NEXT_PUBLIC_APP_URL=http://localhost:3000
